# Replace placeholders in private local .env or cloud environment settings.
WX_APP_ID=YOUR_APP_ID
WX_APP_SECRET=YOUR_WECHAT_APP_SECRET
TENCENT_MAP_KEY=YOUR_TENCENT_MAP_KEY
AI_API_KEY=YOUR_DEEPSEEK_API_KEY
AI_MODEL=deepseek-v4-flash
JYOTI_ENV=production
ALLOW_LOCAL_LOGIN=0

# Member records: local SQLite is development-only; use MySQL in cloud.
JYOTI_STORAGE=mysql
MYSQL_HOST=YOUR_INTERNAL_DATABASE_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=jyoti
MYSQL_USER=YOUR_DATABASE_USER
MYSQL_PASSWORD=YOUR_DATABASE_PASSWORD
# Optional trusted CA path; when configured certificate and hostname are verified.
# MYSQL_SSL_CA=/app/certs/mysql-ca.pem
