<view class="page"><view wx:if="{{!ready}}" class="empty"><view class="section">请先登录并完成出生档案</view><button class="primary" bindtap="home">前往首页</button></view><block wx:else><view class="eyebrow">了解自己的节奏</view><view class="title">{{type==='year'?'年度报告':'本月报告'}}</view><view class="tag">免费基础版</view><button class="secondary" bindtap="analysis">生成 AI 多维解读</button><picker mode="date" fields="{{type==='year'?'year':'month'}}" start="1900-01-01" end="2100-12-31" value="{{period}}" bindchange="change"><view class="subtitle">{{period}} ⌄</view></picker><view wx:if="{{busy}}" class="note">正在获取个人报告…</view><view class="error">{{error}}</view><button wx:if="{{error}}" class="secondary" bindtap="load">重试</button><block wx:if="{{report}}"><view class="card"><view class="section">{{report.theme}}</view><view class="subtitle">{{report.summary}}</view></view><view class="card" wx:for="{{report.sections}}" wx:key="title"><view class="section">{{item.title}}</view><view class="body topspace">{{item.text}}</view><view class="divider"/><view class="note">计算依据：{{item.basis}}</view></view><view class="note">{{report.note}}生成于 {{report.generatedAt}}</view><button class="primary" bindtap="calendar">记录我的关注点</button></block></block></view>
