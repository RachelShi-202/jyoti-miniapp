<view class="page"><view class="title">查询记录</view><view class="error">{{error}}</view><block wx:if="{{result}}"><view class="tag">{{result.isAI?'历史 AI 生成内容':'已保存的记录'}}</view><view class="card"><view class="section">{{result.title}}</view><view class="body">{{result.summary}}</view></view><view class="card" wx:for="{{result.sections}}" wx:key="title"><view class="section">{{item.title}}</view><view class="body">{{item.text || item.strengths}}</view><view class="body">{{item.cautions}}</view></view></block></view>