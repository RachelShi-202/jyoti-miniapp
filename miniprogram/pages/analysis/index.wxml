<view class="page"><view class="eyebrow">多维认识自己</view><view class="title">{{kind==='synastry'?'双人合盘':kind==='year'?'年度解析':kind==='month'?'月度解析':kind==='transit'?'星象解说':'星盘多维解析'}}</view><view class="note">AI 解读仅供娱乐，不是科学预测。只有主动点击才生成。</view><view wx:if="{{!ready}}"><button class="primary" bindtap="home">先完成本次星盘查询</button></view><block wx:elif="{{!history}}"><picker wx:if="{{kind==='year' || kind==='month' || kind==='transit'}}" mode="date" fields="{{kind==='year'?'year':'month'}}" start="1900-01-01" end="2100-12-31" value="{{period}}" bindchange="period"><view class="subtitle">{{period}} ⌄</view></picker>
<view wx:if="{{kind==='synastry'}}" class="card"><view class="section">对方的出生资料</view><picker mode="date" start="1900-01-01" value="{{partner.date}}" data-key="date" bindchange="change"><view class="field">{{partner.date || '出生日期（公历）'}} ⌄</view></picker><picker mode="time" value="{{partner.time}}" data-key="time" bindchange="change"><view class="field">{{partner.time || '出生时刻'}} ⌄</view></picker><picker range="{{foldLabels}}" value="{{foldIndex}}" bindchange="fold"><view class="note">夏令时：{{foldLabels[foldIndex]}} ⌄</view></picker><picker mode="region" value="{{partner.region}}" bindchange="region"><view class="field">{{regionText || '中国大陆省市区'}} ⌄</view></picker><view class="note">使用所选省市区县的近似中心坐标，无需详细地址。</view><view class="note">{{placeBusy?'正在自动匹配经纬度…':'同意下方资料处理说明后，自动匹配所选地区经纬度。'}}</view><view class="note">{{partner.placeLabel}}</view></view>
<checkbox-group bindchange="agree"><label class="check"><checkbox value="yes" checked="{{consent}}" color="#edce92"/><text>同意将计算后的星盘特征发送给 DeepSeek 生成解读，不发送姓名及出生地址。{{kind==='synastry'?'我已获得对方同意使用出生资料，地点查询由腾讯地图处理。':''}}</text></label></checkbox-group><button class="primary" loading="{{busy}}" disabled="{{busy || placeBusy}}" bindtap="generate">{{busy?'AI 正在分析…':'生成分析'}}</button></block><view class="error">{{error}}</view><block wx:if="{{result}}"><view class="card"><view class="tag">{{result.isAI?'AI 生成':'历史记录'}}</view><view class="section">{{result.title}}</view><view class="body">{{result.summary}}</view></view><view class="card" wx:for="{{result.sections}}" wx:key="title"><view class="section">{{item.title}}</view><block wx:if="{{item.strengths}}"><view class="gold topspace">优势</view><view class="body">{{item.strengths}}</view><view class="gold topspace">需要警惕的劣势</view><view class="body">{{item.cautions}}</view></block><view wx:else class="body">{{item.text}}</view></view><view class="note">{{result.notice}}</view><button wx:if="{{!history && member}}" class="secondary" bindtap="save">保存分析（会员）</button></block></view>
